# Docker Compose project isolation
COMPOSE_PROJECT_NAME=videoflix-backend
APP_PORT=8000

# Django
SECRET_KEY=replace_with_a_long_random_secret
DEBUG=False
ALLOWED_HOSTS=api.example.com
CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com,https://api.example.com
CORS_ALLOWED_ORIGINS=https://example.com,https://www.example.com
FRONTEND_URL=https://example.com/projects/videoflix
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=3600
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

# Container versions
# IMPORTANT: Before the first production migration, replace these placeholders
# with the exact versions already used on the VPS. Do not upgrade a PostgreSQL
# major version by only changing this tag.
POSTGRES_IMAGE=postgres:REPLACE_WITH_CURRENT_MAJOR-alpine
REDIS_IMAGE=redis:REPLACE_WITH_SELECTED_MAJOR-alpine

# PostgreSQL
DB_NAME=videoflix
DB_USER=videoflix
DB_PASSWORD=replace_with_a_strong_database_password
DB_HOST=db
DB_PORT=5432

# Redis / RQ
REDIS_HOST=redis
REDIS_LOCATION=redis://redis:6379/1
REDIS_PORT=6379
REDIS_DB=0

# SMTP
EMAIL_HOST=smtp.example.com
EMAIL_PORT=465
EMAIL_HOST_USER=mailbox@example.com
EMAIL_HOST_PASSWORD=replace_with_mailbox_password
EMAIL_USE_TLS=False
EMAIL_USE_SSL=True
DEFAULT_FROM_EMAIL=Videoflix <mailbox@example.com>

# Gunicorn
GUNICORN_WORKERS=2
GUNICORN_TIMEOUT=120

# Optional one-time superuser creation.
# Leave disabled on an already initialized production database.
CREATE_SUPERUSER=False
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=replace_only_if_creation_is_enabled
